<?xml version="1.0" encoding="utf-8"?>
<!--
    QA FLAVOUR ONLY.

    The emulators are reached over `adb reverse`, which is plain HTTP on
    loopback, and Android forbids cleartext by default. This permits it for
    loopback and nothing else, so a mis-set host cannot silently become a
    cleartext call to some other machine.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
