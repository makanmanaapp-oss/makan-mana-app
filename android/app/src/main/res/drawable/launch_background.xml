<?xml version="1.0" encoding="utf-8"?>
<!-- Splash Redesign 2B (Option B): full MakanMana splash-red launch window
     with the official logo centered. Red so there is no white flash before
     the Flutter red splash renders. This file serves API < 31; API 31+ uses
     values-v31 (system splash screen). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/launch_image" />
    </item>
</layer-list>
