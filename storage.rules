rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Gambar Feed Makan: pengguna upload ke folder sendiri sahaja,
    // semua pengguna log masuk boleh lihat. Had 5MB, imej sahaja.
    match /feed_images/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Gambar profil: upload sendiri, semua pengguna log masuk boleh lihat.
    match /profile_images/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Gambar Meal Wallet (foto makanan & resit): peribadi owner.
    // Baca oleh pengguna log masuk (URL sukar diteka + dilindungi rules
    // Firestore untuk konteks); tulis sendiri sahaja.
    match /wallet_images/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Tutup semua yang lain.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
