# MAKANMANA iOS WAVE 3A/3B
#
# Disalin VERBATIM daripada templat SDK Flutter 3.44.4:
#   packages/flutter_tools/templates/cocoapods/Podfile-ios
#
# Ia tidak ditulis dengan tangan dan tiada nilai yang direka. `pod install`
# TIDAK menjana fail ini — ia memerlukannya sudah wujud, jadi ketiadaannya
# ialah penghalang sebenar dan bukan sesuatu yang macOS akan betulkan sendiri.
#
# WAVE 3B: konfigurasi flavour kini WUJUD dalam Runner.xcodeproj, jadi peta di
# bawah telah dikembangkan kepada kesembilan-sembilannya. Peta ini mesti sepadan
# DENGAN TEPAT konfigurasi projek atau `pod install` gagal;
# test/ios_configuration_test.dart menguatkuasakannya pada setiap larian ujian.

# WAVE 3B: DINYAHKOMEN dan DINAIKKAN kepada 15.0.
#
# 11 pemalam Firebase/Cloud yang TERKUNCI dalam pubspec.lock mengisytiharkan
# `ios.deployment_target = '15.0'` (firebase_core, firebase_auth,
# cloud_firestore, firebase_storage, firebase_messaging, firebase_crashlytics,
# firebase_app_check, firebase_analytics, cloud_functions dan lain-lain).
# Dengan baris ini dikomen, CocoaPods menggunakan lalainya sendiri dan
# `pod install` gagal dengan konflik platform. Projek itu sendiri kini juga
# IPHONEOS_DEPLOYMENT_TARGET = 15.0, jadi ketiga-tiganya konsisten.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
  'Debug-prod' => :debug,
  'Profile-prod' => :release,
  'Release-prod' => :release,
  'Debug-qa' => :debug,
  'Profile-qa' => :release,
  'Release-qa' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end
