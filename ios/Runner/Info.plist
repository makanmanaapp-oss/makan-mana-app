<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- Nama yang dilihat pengguna. Datang dari tetapan binaan supaya QA dan
	     produksi boleh dibezakan pada skrin utama semasa QA peranti.
	     Lalai MakanMana ditakrifkan pada SETIAP konfigurasi peringkat-projek,
	     jadi ia tidak pernah diselesaikan menjadi kosong. -->
	<key>CFBundleDisplayName</key>
	<string>$(MM_DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>makan_mana</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Rentetan tujuan: Apple MENOLAK app yang meminta kebenaran ini tanpa
	     penjelasan. Nilai di sini ialah lalai bahasa Inggeris; terjemahan
	     ms/zh/ta hidup dalam <lang>.lproj/InfoPlist.strings. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>MakanMana uses your location to suggest places to eat near you.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>MakanMana uses your location to support nearby food suggestions when location-based features are enabled.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>MakanMana needs access to your photos so you can attach a photo to a post or a bill.</string>
	<key>NSCameraUsageDescription</key>
	<string>MakanMana needs the camera so you can take a photo of your food or a receipt.</string>
	<!-- Background delivery. Runner.entitlements supplies aps-environment;
	     the owner must verify the matching signed provisioning profile on macOS. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ms</string>
		<string>zh-Hans</string>
		<string>ta</string>
	</array>
	<!-- Google Sign-In iOS memanggil balik aplikasi melalui skim URL
	     REVERSED_CLIENT_ID. Nilainya BERBEZA antara QA dan produksi, jadi ia
	     datang dari xcconfig flavour dan bukan dikodkan keras di sini.
	     select_firebase_plist.sh menolak binaan jika ia kosong atau tidak
	     sepadan GoogleService-Info.plist yang sedang dibundel. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>google-sign-in</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(MM_GOOGLE_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
