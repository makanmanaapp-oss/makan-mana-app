// MAKANMANA iOS WAVE 3A/3B — konfigurasi Profile untuk flavour 'prod'.
//
// STATUS: SOURCE READY + struktur pbxproj disahkan.
// Penerimaan Xcode kekal MACOS REQUIRED.
//
// WAVE 3B: konfigurasi binaan 'Profile-prod' kini WUJUD dalam Runner.xcodeproj dan
// merujuk fail ini, dan PRODUCT_BUNDLE_IDENTIFIER telah DIBUANG daripada
// konfigurasi itu — jadi nilai di bawah berkuat kuasa dan bukan lagi
// diabaikan secara senyap.
//
// Ia MASIH belum disahkan oleh Xcode. Sahkan pada macOS dengan:
//   xcodebuild -showBuildSettings -project ios/Runner.xcodeproj
//     -target Runner -configuration Profile-prod | grep PRODUCT_BUNDLE_IDENTIFIER

#include "Generated.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = com.makanmana.apps
// PRODUCT_NAME SENGAJA TIDAK DITETAPKAN.
//
// Menetapkannya menamakan semula bundle (Runner.app -> MakanMana.app),
// yang memecahkan TEST_HOST RunnerTests — ia mengekod-keras Runner.app.
// Ia juga BUKAN nama yang dilihat pengguna: itu CFBundleDisplayName.
// Lihat cadangan nama paparan dalam laporan Wave 3B.

// Dibaca oleh flavour Flutter dan oleh skrip pemilihan plist.
MM_FLAVOR = prod
MM_FIREBASE_PLIST_DIR = $(SRCROOT)/Firebase/prod

// Skim URL panggil-balik Google Sign-In untuk flavour ini.
//
// KOSONG DENGAN SENGAJA. Nilainya ialah REVERSED_CLIENT_ID di dalam
// GoogleService-Info.plist flavour 'prod', dan ia BERBEZA antara QA dan
// produksi. Ia tidak boleh direka — salin nilai sebenar selepas plist
// dimuat turun dari konsol Firebase.
//
// select_firebase_plist.sh MENOLAK binaan jika ia kosong atau jika ia tidak
// sepadan plist yang sedang dibundel, jadi nilai yang salah tidak boleh
// dihantar secara senyap.
MM_GOOGLE_REVERSED_CLIENT_ID =
